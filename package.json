{
  "name": "jovi-flow-fiap-2026",
  "private": true,
  "description": "JOVI Flow — 3-touch mobile camera web app (FIAP Challenge 2026, Sprint 2)",
  "scripts": {
    "css": "tailwindcss -i src/poc/css/input.css -o src/poc/css/jovi.css --minify",
    "css:watch": "tailwindcss -i src/poc/css/input.css -o src/poc/css/jovi.css --watch",
    "test": "node scripts/qa-mobile-audit.mjs",
    "pdf": "node scripts/generate-presentation-pdf.mjs",
    "zip": "node scripts/package-zip.mjs",
    "dist": "npm run zip"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "puppeteer": "^25.8.0"
  }
}
